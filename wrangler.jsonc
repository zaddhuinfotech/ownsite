{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "ownsite",

  "compatibility_date": "2026-07-31",

  "assets": {
    "directory": "build",
    "not_found_handling": "single-page-application"
  },

  "routes": [
    {
      "pattern": "zaddhu.com/*",
      "zone_name": "zaddhu.com"
    },
    {
      "pattern": "www.zaddhu.com/*",
      "zone_name": "zaddhu.com"
    }
  ],

  "observability": {
    "enabled": true
  }
}
